# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION secrets — SERVER-SIDE ONLY. NEVER bundled into the browser.
#
# Local dev:   copy to `supabase/functions/.env` and run `supabase functions serve`
#              (this file is gitignored as supabase/functions/.env — keep it local).
# Production:  do NOT ship this file. Set each secret with:
#                  supabase secrets set NAME=value
#              (Supabase auto-provisions SUPABASE_URL / SUPABASE_*_KEY / SUPABASE_JWKS
#               in the deployed runtime — you only set the non-Supabase ones in prod.)
#
# Full step-by-step for every value:  ../../KEYS_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server) ────────────────────────────────────────────────────────
# Secret key (sb_secret_…) — privileged, BYPASSRLS. Server-only. Used for token
# decryption + privileged writes. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
# Publishable key (sb_publishable_…) — used to build an RLS-scoped client that
# verifies the caller's JWT. Falls back to SUPABASE_ANON_KEY if unset.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
# Needed locally (auto-set in the deployed runtime):
SUPABASE_URL="https://your-project-ref.supabase.co"
# Legacy fallbacks (only if you have not migrated to sb_secret_/sb_publishable_):
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_ANON_KEY=""

# ── Microsoft Graph (Outlook + Teams) — one Entra app registration ───────────
# Can REUSE the same Entra app as the existing SharePoint integration (AZURE_* below).
MS_GRAPH_CLIENT_ID="00000000-0000-0000-0000-000000000000"
MS_GRAPH_CLIENT_SECRET="your-entra-client-secret-VALUE-not-id"
MS_GRAPH_TENANT_ID="00000000-0000-0000-0000-000000000000"
# Must EXACTLY equal the deployed ms-oauth-callback URL AND be registered as a
# redirect URI in the Entra app:
MS_GRAPH_REDIRECT_URI="https://your-project-ref.supabase.co/functions/v1/ms-oauth-callback"

# ── Crypto / webhook ─────────────────────────────────────────────────────────
# AES-256-GCM key material for encrypting ms_connections.refresh_token_enc + signing
# OAuth state. Generate:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
# Shared secret validating inbound Graph webhook notifications.
# Generate:  openssl rand -hex 32
GRAPH_WEBHOOK_CLIENT_STATE="generate-with-openssl-rand-hex-32"
# Optional: overrides the derived webhook URL (default ${SUPABASE_URL}/functions/v1/graph-webhook)
# GRAPH_WEBHOOK_URL="https://your-project-ref.supabase.co/functions/v1/graph-webhook"

# ── AI summary (Teams transcripts) ───────────────────────────────────────────
# Read-only AI gateway. The existing ai-assistant function reads LOVABLE_API_KEY;
# the Teams transcribe-summarize function reads AI_ASSISTANT_API_KEY. Set BOTH to
# the same gateway key (or alias) — see KEYS_SETUP.md.
LOVABLE_API_KEY="your-ai-gateway-key"
AI_ASSISTANT_API_KEY="your-ai-gateway-key"

# ── Existing SharePoint integration (sharepoint-provision) ───────────────────
# Already in use. The same Entra app can back MS_GRAPH_* above.
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET="your-entra-client-secret-VALUE"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
SP_DRIVE_ID="your-sharepoint-drive-id"
SP_ROOT_FOLDER="your-sharepoint-root-folder"

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Defaults to "*". Set to your app origin to lock CORS down.
# ALLOWED_ORIGIN="https://your-app-domain.com"
