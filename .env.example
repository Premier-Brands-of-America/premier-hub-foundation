# ─────────────────────────────────────────────────────────────────────────────
# CLIENT environment (Vite) — bundled into the browser build.
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ONLY put browser-safe, RLS-scoped values here. NEVER put a secret key
# (sb_secret_… / service_role) or any MS_GRAPH_*/TOKEN_* value in this file —
# those are Edge Function secrets (see KEYS_SETUP.md + supabase/functions/.env.example).
#
# Full step-by-step for every value:  ./KEYS_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project ref (the subdomain of your project URL). Used by the
# Supabase CLI/tooling; the app itself reads URL + publishable key below.
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Project API URL: https://<project-ref>.supabase.co
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# PUBLISHABLE key — browser-safe, RLS-enforced. Use the new key family
# (sb_publishable_…) from Supabase → Settings → API Keys. A legacy `anon` JWT
# still works during the transition, but prefer sb_publishable_… (see KEYS_SETUP.md).
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
